<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: a road receding toward an amber radar beacon.
  Adaptive-icon canvas is 108x108 with a 66dp-diameter safe zone centered at
  (54,54): all content stays within ~radius 32 so circular masks never clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Road -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M43,84 L50.5,42 L57.5,42 L65,84 Z" />

    <!-- Dashed centerline (perspective-scaled) -->
    <path
        android:fillColor="#1976D2"
        android:pathData="M52.6,80 L55.4,80 L55.1,71 L52.9,71 Z
                          M53,65.5 L55,65.5 L54.8,58 L53.2,58 Z
                          M53.35,53.5 L54.65,53.5 L54.55,47.5 L53.45,47.5 Z" />

    <!-- Radar beacon dot at the vanishing point -->
    <path
        android:fillColor="#FFC107"
        android:pathData="M54,35 m-4.2,0 a4.2,4.2 0 1 1 8.4,0 a4.2,4.2 0 1 1 -8.4,0" />

    <!-- Radar arcs -->
    <path
        android:pathData="M47.64,28.64 A9,9 0 0 1 60.36,28.64"
        android:strokeColor="#FFC107"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M44.45,25.45 A13.5,13.5 0 0 1 63.55,25.45"
        android:strokeColor="#FFC107"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
